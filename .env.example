# Server Configuration
PORT=5000
NODE_ENV=development
MOCK_MODE=false

# CORS
CORS_ORIGIN=http://localhost:3001

# Database Settings
DATABASE_URL=mongodb://localhost:27017/threadlearn
# Optional comma-separated DNS servers for MongoDB Atlas SRV lookup
DNS_SERVERS=
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_DATABASE=

# Caching and Rate Limiting
REDIS_URL=redis://localhost:6379
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_MS=900000

# Authentication (JWT Setup)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URLs
FRONTEND_URL=http://localhost:3001

# Payment gateway
PAYMENT_GATEWAY_MODE=mock
VNP_TMN_CODE=your-vnpay-terminal-code
VNP_HASH_SECRET=your-vnpay-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3001/pricing/callback
VNP_IPN_URL=http://localhost:5000/api/v1/subscription/webhook/payment
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# OAuth Credentials
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret

# SMTP Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM_NAME=ThreadLearn
MAIL_FROM_EMAIL=your-email@gmail.com

# Code Sandbox API (Judge0 Setup)
JUDGE0_API_URL=https://api.judge0.com
JUDGE0_API_KEY=your-optional-judge0-api-key

# File upload paths (Multer attachments local save path)
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=10
