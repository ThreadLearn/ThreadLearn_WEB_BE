# Server Configuration
PORT=5000
NODE_ENV=development
MOCK_MODE=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend
FRONTEND_URL=http://localhost:3000

# Database Settings
DATABASE_URL=mongodb://localhost:27017/threadlearn
# Alternatively provide the full MongoDB Atlas pieces instead of DATABASE_URL:
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_DATABASE=

# Caching and Rate Limiting
REDIS_URL=redis://localhost:6379
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_MS=900000

# Authentication (JWT Setup)
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Frontend OAuth redirects
FRONTEND_AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/callback
FRONTEND_AUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login

# SMTP Mail (all of HOST, PORT, USER, PASS and MAIL_FROM_EMAIL must be set to enable SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM_NAME=ThreadLearn
MAIL_FROM_EMAIL=your_email@gmail.com

# Code Sandbox API (Judge0 Setup)
JUDGE0_API_URL=https://api.judge0.com
JUDGE0_API_KEY=your_optional_judge0_api_key

# File upload paths (Multer attachments local save path)
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=10

# Database seed (local dev admin account)
SEED_ADMIN_EMAIL=admin@threadlearn.com
SEED_ADMIN_PASSWORD=Admin@123
