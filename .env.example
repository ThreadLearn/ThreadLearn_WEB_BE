# Server Configuration
PORT=5000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Database Settings
DATABASE_URL=mongodb://localhost:27017/threadlearn

# Caching and Rate Limiting
REDIS_URL=redis://localhost:6379
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_MS=900000

# Authentication (JWT Setup)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NextAuth config
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=your_nextauth_jwt_secret_change_me

# OAuth Credentials
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret

# Code Sandbox API (Judge0 Setup)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=7954a6c237msh83ea5c47ea271dap1c961fjsn56dc42bdf466
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_TIMEOUT_MS=10000

# AI Analysis (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key

# File upload paths (Multer attachments local save path)
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=10

