{
  "name": "threadlearn-backend",
  "version": "1.0.0",
  "description": "Scalable modular backend architecture for ThreadLearn using Next.js, MongoDB, Mongoose, and Redis.",
  "main": "server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch .next --ignore-watch dist --ignore-watch logs server.ts",
    "build": "next build && tsc --project tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "next": "^14.1.0",
    "react": "^19.2.6",
    "react-dom": "^18.2.0",
    "mongoose": "^8.1.1",
    "redis": "^4.6.12",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "next-auth": "^4.24.5",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.11.0",
    "swagger-ui-express": "^5.0.0",
    "dotenv": "^16.4.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^18.2.19",
    "@types/node": "^20.11.16",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  }
}
