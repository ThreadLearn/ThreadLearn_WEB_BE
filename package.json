{
  "name": "threadlearn-backend",
  "version": "2.0.0",
  "description": "ThreadLearn API — NestJS + MongoDB + Redis + Socket.IO",
  "scripts": {
    "dev":            "nest start --watch",
    "build":          "nest build",
    "start":          "node dist/main",
    "lint":           "eslint \"{src,test}/**/*.ts\"",
    "format":         "prettier --write \"src/**/*.ts\"",
    "test:rules":     "ts-node -P tsconfig.json test/business-rules.ts",
    "test:logic":     "ts-node -P tsconfig.json test/logic-rules.ts",
    "test:e2e":       "ts-node -P tsconfig.json test/e2e-smoke.ts",
    "test:journey":   "ts-node -P tsconfig.json test/seed-and-smoke.ts",
    "test:contracts": "ts-node -P tsconfig.json src/scripts/mock-integration-check.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/websockets": "^10.3.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "mongoose": "^8.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.4",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/node": "^20.11.16",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
